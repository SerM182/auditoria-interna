datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Auditoria {
  id                              Int       @id @default(autoincrement())
  codigoProyecto                  String
  fecha                           DateTime
  nHallazgos                      Int
  gerenciaResponsable             String
  descripcionHallazgo             String
  descripcionAccionCorrectiva     String
  fechaImplementacionCorreccion   DateTime?
  seguimientosAcciones            String?
  observaciones                   String?
  fechaVerificacionImplementacion DateTime?
  fechaEvaluacionEficacia         DateTime?
  evaluacionEficacia              String?
  responsable                     String
  estadoObservacion               String

  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
}

model Usuario {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String
  role               String   @default("auditoria_interna")
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
